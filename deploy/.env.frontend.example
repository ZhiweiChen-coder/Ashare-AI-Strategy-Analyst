# Reference only: configure these through the Vercel environment settings.
# Use the public production origin for canonical URLs in both production and previews.
NEXT_PUBLIC_SITE_URL=https://openashare.com
BACKEND_BASE_URL=https://api.openashare.com
# Vercel also detects its hosted runtime automatically. This flag supports other beta hosts.
OPENASHARE_PUBLIC_BETA=true
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Production should leave this unset or false. Vercel preview builds are noindex automatically.
SEO_NOINDEX=false

# Optional waitlist invitation email settings; credentials belong only in Vercel.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=OpenAshare
